rules_version = '2';

// DEVELOPMENT RULES - Simplified for testing
// TODO: Tighten rules before production deployment

service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================================
    // Helper Functions
    // ===========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ===========================================
    // Users Collection (Customers)
    // ===========================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===========================================
    // Admins Collection
    // ===========================================
    match /admins/{adminId} {
      // Allow get for own profile or any admin
      allow get: if isOwner(adminId) || isAdmin();
      // Allow list for admins, or any authenticated user if limiting to 1 (for checking if first user)
      allow list: if isAdmin() || (isAuthenticated() && request.query.limit <= 1);

      // Allow first user to create admin (no existing admins or users)
      allow create: if isAuthenticated();

      // Allow admin to update own profile or other admins
      allow update: if isOwner(adminId) || isAdmin();

      // Allow admin to delete
      allow delete: if isAdmin();
    }

    // ===========================================
    // Products Collection
    // ===========================================
    match /products/{productId} {
      // Anyone can read products (for storefront)
      allow read: if true;

      // Only admins can write entirely, but customers can update stock when checking out
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'quantity', 'updatedAt']));
    }

    // ===========================================
    // Categories Collection
    // ===========================================
    match /categories/{categoryId} {
      // Anyone can read categories (for storefront)
      allow read: if true;

      // Only admins can write
      allow create, update, delete: if isAdmin();
    }

    // ===========================================
    // Orders Collection
    // ===========================================
    match /orders/{orderId} {
      allow read: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===========================================
    // Training Modules Collection
    // ===========================================
    match /trainingModules/{moduleId} {
      // Anyone can read training modules (for storefront list)
      allow read: if true;

      // Only admins can write
      allow create, update, delete: if isAdmin();
    }

    // ===========================================
    // Other Collections (Delivery, Deals, Coupons, etc.)
    // ===========================================
    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pickupLocations/{locId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /deals/{dealId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /returns/{returnId} {
      allow read: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true; // Allow anyone to create reviews initially (status: 'pending')
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if true; // Allow anyone to submit a testimonial
      allow update, delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    match /tickets/{ticketId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /trainingSubscriptions/{subId} {
      allow read, write: if isAuthenticated();
    }
  }
}
